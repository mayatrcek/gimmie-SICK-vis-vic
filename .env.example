# Contact form (app/api/contact/route.ts) — resend.com API key.
# Copy this file to .env.local and fill in the real value; also set it in
# the Vercel project's env vars for prod.
RESEND_API_KEY=

# Satellite imagery (lib/api/sentinel.ts) — Copernicus Data Space Ecosystem
# OAuth client (Sentinel Hub Dashboard -> User Settings -> OAuth clients).
# Set in Vercel for Production, Preview, AND Development — missing Preview
# 500s PR deploys while main keeps working.
# The client recreated on 2026-10-29 is set to never expire. The one before it
# expired without warning: token calls got 401 invalid_client and the gallery
# went empty.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
