{
  "name": "OVERWORLD",
  "description": "A pixel-art editorial design system for worldbuilders, indie game studios, and digital cartographers. Chunky 16-bit landscapes punch through oversized blocky display type on warm parchment.",
  "theme": "light",
  "stylingMode": "css",
  "concept": "OVERWORLD treats pixel art like fine print. Giant Pixelify Sans headlines, asymmetric margins, and SNES-style hard-shadow blocks frame full-bleed pixel landscapes that intentionally break the layout grid.",
  "palette": [
    {
      "name": "Parchment",
      "value": "#F2EAD6",
      "role": "Main page background and primary surface"
    },
    {
      "name": "Bone",
      "value": "#FFFAEF",
      "role": "Raised card surface and inverse type on dark blocks"
    },
    {
      "name": "Ink",
      "value": "#161310",
      "role": "Display type, 2px borders, and hard offset shadows"
    },
    {
      "name": "Sky Cobalt",
      "value": "#2E5DD6",
      "role": "Primary accent, links, focus rings, and badge fills"
    },
    {
      "name": "Sunset Vermillion",
      "value": "#E2522E",
      "role": "Secondary accent for status, alerts, and attention"
    },
    {
      "name": "Pine Moss",
      "value": "#2F6E4F",
      "role": "Tertiary accent for success states and nature labels"
    },
    {
      "name": "Border Tan",
      "value": "#D9CDB3",
      "role": "Soft borders, dividers, and muted secondary lines"
    }
  ],
  "fonts": [
    {
      "name": "Pixelify Sans",
      "provider": "Google Fonts",
      "usage": "Oversized display headlines, wordmark, button labels, and signature pixel type",
      "cssImport": "https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;500;600;700&display=swap"
    },
    {
      "name": "Inter",
      "provider": "Google Fonts",
      "usage": "Body copy, paragraphs, and readable interface text",
      "cssImport": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    },
    {
      "name": "VT323",
      "provider": "Google Fonts",
      "usage": "Tiny labels, badge chrome, HUD-style marginalia, and captions",
      "cssImport": "https://fonts.googleapis.com/css2?family=VT323&display=swap"
    }
  ],
  "iconPack": {
    "name": "Phosphor Icons",
